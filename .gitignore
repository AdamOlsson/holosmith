# Rust build output
/target/

# The cross toolchain scripts/build.sh fetches into the tree when neither PATH nor this directory has one
/toolchains/

# Artifacts: scripts/build.sh writes dist/<target-triple>/holosmith
/dist/

# A release tree left at the checkout's root by a build this tree no longer has; nothing writes one now, so this
# hides a stray directory in an older checkout rather than an artifact of today's build
/releases/

# Frontend build output; the app is embedded in the binary (ADR-0004)
/web/dist/
/node_modules/
/web/node_modules/
